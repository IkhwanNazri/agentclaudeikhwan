    "to": 6.59,
    "voice": "akp_0.wav",
    "say": "Korang pernah duduk asrama? Pernah tak tinggal sorang-sorang masa cuti hujung minggu?"
   },
   {
    "who": "cohost",
    "from": 6.99,
    "to": 12.12,
    "voice": "akp_1.wav",
    "say": "Pernah... sunyi gila. Kenapa? Ada benda jadi ke?"
   },
   {
    "who": "host",
    "from": 12.52,
    "to": 18.96,
    "voice": "akp_2.wav",
    "say": "Malam ni aku nak cerita pasal satu asrama... dan tiga ketukan di pintu dorm."
   },
   {
    "who": "cohost",
    "from": 19.36,
    "to": 23.2,
    "voice": "story/b378p4b.wav",
    "say": "Sebelum kita mulakan cerita, jangan lupa follow."
   },
   {
    "who": "host",
    "from": 23.6,
    "to": 26.88,
    "voice": "story/b378-p5.wav",
    "say": "Baik. Sekarang, kita mulakan kisahnya."
   }
  ]
